# mock | openai | anthropic   (mock works without any API key)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Storage: CSV is always on; Google Sheets is optional (service account JSON)
LEADS_CSV_PATH=data/leads.csv
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=

# Telegram alerts for hot leads (leave empty to just log them)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional shared secret, sent by your form in the X-Webhook-Secret header
WEBHOOK_SECRET=
HOT_SCORE_THRESHOLD=70
